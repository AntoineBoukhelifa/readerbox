{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "readerbox-cron",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_als"],
	"main": "workers/cron.ts",

	// Un second Worker, et c'est une contrainte de l'adaptateur plutôt qu'un
	// choix : `@sveltejs/adapter-cloudflare` efface et réécrit le fichier désigné
	// par `main` dans `wrangler.jsonc` avec son propre `_worker.js`, qui n'exporte
	// que `fetch`. Un handler `scheduled` ne peut donc pas cohabiter dans le même
	// Worker sans réécrire du code généré après chaque build.
	//
	// Les deux Workers partagent la même base D1. Déploiement :
	//   wrangler deploy --config wrangler.cron.jsonc

	// Toutes les cinq minutes. Le Cron Trigger est inclus au palier gratuit, à la
	// différence des files d'attente Cloudflare — c'est le seul ordonnanceur dont
	// on dispose. Cinq minutes est le compromis retenu entre la fraîcheur d'une
	// cascade interrompue et le nombre d'invocations quotidiennes ; à ajuster
	// quand un usage réel aura été observé.
	"triggers": {
		"crons": ["*/5 * * * *"]
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "readerbox",
			"database_id": "1662bc35-c287-4884-aa7e-88ef1d69f93f",
			"migrations_dir": "drizzle"
		}
	]
}
